# Elite Estimating runtime
PORT=8787

# REQUIRED for current service-token authentication. Use a random secret >=32 characters.
ELITE_AUTH_SECRET=replace-with-a-long-random-secret

# REQUIRED for durable production persistence.
DATABASE_URL=

# Optional in local/test only. Never enable for production.
ELITE_ALLOW_EPHEMERAL=0

# Protected Prometheus metrics endpoint. If unset, /metrics returns 404.
ELITE_METRICS_TOKEN=

# Mutation safety. When required, estimate creation must include Idempotency-Key.
ELITE_REQUIRE_IDEMPOTENCY=0

# Authenticated per-process token bucket. Configure both values to enable it.
# Set ELITE_REQUIRE_RATE_LIMIT=1 in production only after capacity/refill values are configured.
ELITE_REQUIRE_RATE_LIMIT=0
ELITE_RATE_LIMIT_CAPACITY=
ELITE_RATE_LIMIT_REFILL_PER_SECOND=

# Evidence object storage. Cloudflare R2 uses the S3-compatible API.
# Set ELITE_REQUIRE_BLOB_STORAGE=1 in production so /ready fails if these are missing.
ELITE_REQUIRE_BLOB_STORAGE=0
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Claims Management lifecycle delivery. Required when enabling outbox dispatch.
ELITE_CLAIMS_WEBHOOK_URL=
ELITE_CLAIMS_WEBHOOK_SECRET=

# Optional production outbox health policy. Leave blank to observe without blocking readiness.
# Values are non-negative integers. Exhausted means the delivery attempt ceiling was reached.
ELITE_OUTBOX_MAX_PENDING=
ELITE_OUTBOX_MAX_AGE_SECONDS=
ELITE_OUTBOX_MAX_EXHAUSTED=

# Enterprise identity / SSO. When all OIDC values are present, OIDC/JWKS becomes the preferred auth mode.
ELITE_OIDC_ISSUER=
ELITE_OIDC_AUDIENCE=
ELITE_OIDC_JWKS_URL=
ELITE_OIDC_TENANT_CLAIM=tenant_id
ELITE_OIDC_ROLES_CLAIM=roles

# Licensed provider credentials. Enable only after contractual/data-rights review.
MOTOR_API_KEY=
ALLDATA_API_KEY=
CIECA_CLIENT_ID=
CIECA_CLIENT_SECRET=
ACORD_CLIENT_ID=
ACORD_CLIENT_SECRET=

# Additional providers should follow ELITE_PROVIDER_<NAME>_* naming and remain tenant-scoped when required.
