{
  "schema": "elite.frontier-capability-adapter.v1",
  "service": "ELITE-ESTIMATING-",
  "role": "domain-authoring",
  "standalone": true,
  "degradedMode": true,
  "capabilities": [
    "reasoning",
    "structured-output",
    "knowledge-retrieval"
  ],
  "owns": [
    "estimate-authoring",
    "estimate-review",
    "estimating-calculations"
  ],
  "frontier": {
    "requestSchema": "elite.frontier-handoff.v1",
    "receiptSchema": "elite.frontier-receipt.v1",
    "mayRequestExecution": true,
    "mayBypassAuthorization": false,
    "preserveTenant": true,
    "preserveCorrelation": true
  },
  "fallback": {
    "sharedFabricUnavailable": "use-native-capabilities",
    "remoteExecutionRequired": false
  }
}
