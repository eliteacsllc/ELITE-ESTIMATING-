{
  "version": "elite.integration-contract.v1",
  "serviceId": "elite-estimating",
  "repository": "eliteacsllc/ELITE-ESTIMATING-",
  "standalone": true,
  "spines": [
    "claims"
  ],
  "role": "multi-vertical estimating and valuation engine",
  "dependencies": {
    "upstream": [
      "claims-management",
      "damage-iq",
      "estimatics-library"
    ],
    "downstream": [
      "elite-qa"
    ]
  },
  "runtime": {
    "urlEnv": "ELITE_ESTIMATING_URL",
    "localPathEnv": "ELITE_ESTIMATING_PATH",
    "healthPath": "/ready",
    "localCheckCommand": "npm run build && npm test"
  },
  "releaseGates": [
    "tests",
    "security",
    "tenant-isolation",
    "audit",
    "backup-recovery",
    "observability",
    "integration-contract"
  ],
  "policies": {
    "failure": "fail-closed",
    "providerNeutral": true,
    "noSharedDatabaseByDefault": true,
    "explicitApiContracts": true,
    "humanGovernedRelease": true
  },
  "discovery": {
    "registryEnv": "ELITE_SERVICE_REGISTRY_URL",
    "registryTokenEnv": "ELITE_SERVICE_REGISTRY_TOKEN",
    "directUrlWins": true,
    "registryOptional": true
  },
  "standardRef": "eliteacsllc/elite-sdk:contracts/standalone-integration-standard.v1.json",
  "integrationRequirements": {
    "api": {
      "required": true,
      "versioned": true,
      "openapi": true,
      "health": true,
      "readiness": true
    },
    "identity": {
      "oauth2Oidc": true,
      "workloadIdentity": true,
      "tenantContext": true,
      "rbac": true
    },
    "events": {
      "required": true,
      "versioned": true,
      "correlationId": true,
      "idempotency": true,
      "deadLetter": true
    },
    "sdk": {
      "required": true,
      "package": "@elite/sdk",
      "providerNeutral": true
    },
    "data": {
      "serviceOwned": true,
      "noSharedDatabaseByDefault": true,
      "explicitContracts": true
    },
    "resilience": {
      "timeouts": true,
      "boundedRetries": true,
      "circuitBreaking": true,
      "gracefulDegradation": true
    },
    "observability": {
      "structuredLogs": true,
      "metrics": true,
      "traces": true,
      "correlationPropagation": true
    }
  },
  "maturity": {
    "declared": true,
    "sourceVerified": false,
    "runtimeVerified": false,
    "level": "UNVERIFIED"
  }
}
