{
  "schemaVersion": "1.0",
  "contract": "elite.intelligence-adapter.v1",
  "runtimeOwner": "eliteacsllc/blackbox",
  "contractOwner": "eliteacsllc/elite-sdk",
  "systemOfRecord": "local",
  "domainLogicRemainsLocal": true,
  "capabilities": [
